{
  "manifest_version": 3,
  "name": "Repo Risk Signals",
  "version": "0.2.0",
  "description": "Automatically flags GitHub repository security and contributor risk signals.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*", "https://github.com/*/*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Repo Risk Signals"
  }
}
